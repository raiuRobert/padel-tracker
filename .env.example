# Real-time multi-device sync (optional).
#
# Without these the app runs entirely on-device, exactly as before — sessions just don't sync.
# With them, sessions are shared through Supabase and update live across everyone's phones.
#
# Copy to .env.local and fill in from your Supabase project's API settings. The publishable key is
# safe to expose in the browser; access is governed by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
